{
  "rewrites": [
    {
      "source": "/api/cloud/:rest(.*)",
      "destination": "https://cloud.shipcue.ai/api/cloud/:rest"
    },
    {
      "source": "/api/shipcue/:rest(.*)",
      "destination": "/api/shipcue?__p=:rest"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "https://cloud.shipcue.ai/",
      "permanent": false
    },
    {
      "source": "/app/",
      "destination": "https://cloud.shipcue.ai/",
      "permanent": false
    },
    {
      "source": "/changelog",
      "destination": "/cuelog/",
      "permanent": true
    },
    {
      "source": "/changelog/",
      "destination": "/cuelog/",
      "permanent": true
    },
    {
      "source": "/cue",
      "destination": "/cuelog/",
      "permanent": true
    },
    {
      "source": "/cue/",
      "destination": "/cuelog/",
      "permanent": true
    }
  ]
}
