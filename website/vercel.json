{
  "rewrites": [
    {
      "source": "/api/cloud/:rest(.*)",
      "destination": "/api/cloud?__p=:rest"
    },
    {
      "source": "/api/shipcue/:rest(.*)",
      "destination": "/api/shipcue?__p=:rest"
    }
  ],
  "redirects": [
    {
      "source": "/changelog",
      "destination": "/cuelog/",
      "permanent": true
    },
    {
      "source": "/changelog/",
      "destination": "/cuelog/",
      "permanent": true
    },
    {
      "source": "/cue",
      "destination": "/cuelog/",
      "permanent": true
    },
    {
      "source": "/cue/",
      "destination": "/cuelog/",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cloud/digest",
      "schedule": "0 14 * * *"
    }
  ]
}
