{
  "rewrites": [
    {
      "source": "/api/shipcue/:rest(.*)",
      "destination": "/api/shipcue?__p=:rest"
    }
  ],
  "redirects": [
    {
      "source": "/changelog",
      "destination": "/cuelog/",
      "permanent": true
    },
    {
      "source": "/changelog/",
      "destination": "/cuelog/",
      "permanent": true
    },
    {
      "source": "/cue",
      "destination": "/cuelog/",
      "permanent": true
    },
    {
      "source": "/cue/",
      "destination": "/cuelog/",
      "permanent": true
    }
  ]
}
